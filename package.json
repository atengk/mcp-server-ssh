{
  "name": "@atengk/mcp-server-ssh",
  "version": "1.2.3",
  "description": "基于 SSH 协议连接与操控 Linux/Unix 系统的 Model Context Protocol (MCP) 服务",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atengk/mcp-server-ssh.git"
  },
  "homepage": "https://github.com/atengk/mcp-server-ssh#readme",
  "bugs": {
    "url": "https://github.com/atengk/mcp-server-ssh/issues"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mcp-server-ssh": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ssh",
    "linux",
    "sftp",
    "devops",
    "ai-agent"
  ],
  "author": "Ateng",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "dotenv": "^16.4.7",
    "ssh-config": "^5.0.0",
    "ssh2": "^1.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ssh2": "^1.15.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
